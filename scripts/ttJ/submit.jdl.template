# HTCondor submit file for the ttJ jobs (CERN lxbatch with eossubmit). Copy to a submit directory on EOS, replace the
# @...@ placeholders, and submit from lxplus:  module load lxbatch/eossubmit && condor_submit submit.jdl
# The jobs install the pixi environment of @CODE@/pixi.lock themselves, offline from the package cache in @PIXICACHE@
# (scripts/ttJ/pixi_cache.sh @PIXICACHE@, once per lock file); to use a conda environment instead, add TTJ_CONDA=<env>
# to "environment".
executable            = @CODE@/scripts/ttJ/run_job.sh
arguments             = $(name) $(syst) $(campaign) $(year)
environment           = "TTJ_WF=@WF@ TTJ_CODE=@CODE@ TTJ_SUBJSON=@SUBJSON@ TTJ_OUT=@OUT@ TTJ_PIXI_CACHE=@PIXICACHE@ X509_USER_PROXY=@PROXY@"
initialdir            = @SUBMITDIR@
log                   = logs/ttJ.$(ClusterId).log
output                = out/$(name).out
error                 = out/$(name).err
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
# nothing back to the submit directory: the outputs go to @OUT@ directly, and the default would copy every new file of
# the job directory (the pixi environment and its package cache, over 1 GB, and the credential cache)
transfer_output_files = ""
# 10-file data jobs take about an hour; "tomorrow" (24 h) leaves room for slow xrootd reads
+JobFlavour           = "tomorrow"
request_cpus          = 1
request_memory        = 4000
max_retries           = 3
# at most this many jobs of the cluster in the queue at once (all jobs read the code on EOS)
max_materialize       = 400
queue name,syst,campaign,year from jobs.txt
